# Copiar a deploy/.env.prod. Generar cada secreto con: openssl rand -base64 48
VMS_DOMINIO=vms.ejemplo.com
POSTGRES_USER=vms
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=vms

JWT_SECRET=cambiar
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=8h
JWT_QR_SECRET=cambiar
# openssl rand -base64 32. Si se pierde, los datos cifrados no se pueden recuperar
CRYPTO_KEY=cambiar
CRYPTO_PEPPER=cambiar

SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cambiar
SMTP_PASS=cambiar
SMTP_FROM="VMS Planta Textil <vms@ejemplo.com>"

# http para el torniquete real; simulado solo en pruebas
ACS_MODE=http
ACS_URL=https://acs.ejemplo.com
ACS_TIMEOUT_MS=3000
ACS_SIMULADO_COMPORTAMIENTO=ok

ENLACE_PREREGISTRO_HORAS=72
QR_MARGEN_ANTES_MIN=60
QR_MARGEN_DESPUES_MIN=120
PERMANENCIA_DEFAULT_MIN=240
INDUCCION_PUNTAJE_MINIMO=80
INDUCCION_VIGENCIA_MESES=12
RETENCION_DIAS=365
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=30
