FROM node:26-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_PUENTE_URL=ws://127.0.0.1:8765
ENV NEXT_PUBLIC_PUENTE_URL=$NEXT_PUBLIC_PUENTE_URL
RUN npm run build
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "start"]
