# ---------------------------------------------------------------
# Variables de entorno del VMS. Copiar a .env en la raíz (docker)
# y a backend/.env (API). El frontend usa frontend/.env.local.
# ---------------------------------------------------------------

# --- Docker (docker-compose.yml) ---
POSTGRES_USER=vms
POSTGRES_PASSWORD=vms_dev
POSTGRES_DB=vms
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026

# --- Backend (backend/.env) ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://vms:vms_dev@localhost:5432/vms?schema=public

# Secretos: generar con `openssl rand -base64 48`
JWT_SECRET=cambiar_por_un_secreto_largo_para_sesiones
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=8h
JWT_QR_SECRET=cambiar_por_un_secreto_largo_para_credenciales_qr
# Clave AES-256 en base64 (32 bytes): `openssl rand -base64 32`
CRYPTO_KEY=cambiar_por_clave_base64_de_32_bytes
# Pepper para hashes de búsqueda (documento, correo)
CRYPTO_PEPPER=cambiar_por_un_pepper_largo

# Correo (Mailpit en desarrollo)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="VMS Planta Textil <vms@plantatextil.local>"

# Control de acceso físico (ACS)
ACS_MODE=simulado            # simulado | http
ACS_URL=http://localhost:4000/acs
ACS_TIMEOUT_MS=3000
ACS_SIMULADO_COMPORTAMIENTO=ok   # ok | timeout | error

# Reglas de negocio por defecto (editables desde /configuracion)
ENLACE_PREREGISTRO_HORAS=72
QR_MARGEN_ANTES_MIN=60
QR_MARGEN_DESPUES_MIN=120
PERMANENCIA_DEFAULT_MIN=240
INDUCCION_PUNTAJE_MINIMO=80
INDUCCION_VIGENCIA_MESES=12
RETENCION_DIAS=365
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MIN=30

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_PUENTE_URL=ws://127.0.0.1:8765   # servicio local del huellero (puente-huellero/)
